# Server-only sign-in secrets. Never use NEXT_PUBLIC_ for these.
# Password hash format: 16-byte random salt (hex):64-byte scrypt hash (hex).
WAREHOUSE_PASSWORD_HASH=
# At least 32 random characters; keep stable across deployments.
WAREHOUSE_SESSION_SECRET=
# Connected private Vercel Blob store provisions credentials automatically.
# Never copy real credentials into this file or commit them.
BLOB_READ_WRITE_TOKEN=
